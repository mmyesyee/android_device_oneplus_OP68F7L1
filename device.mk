# Inherit the MT6878 platform makefile (virtual A/B, init scripts, fstab,
# properties, update engine, ...).
$(call inherit-product, device/oneplus/mt6878-common/common.mk)

# AAPT / screen
PRODUCT_AAPT_CONFIG := normal
PRODUCT_AAPT_PREF_CONFIG := xxhdpi

# Boot animation geometry (1080x2400, 480 dpi)
TARGET_SCREEN_HEIGHT := 2400
TARGET_SCREEN_WIDTH := 1080

# Fingerprint (side-mounted, integrated in the power button)
#
# The stock OPLUS HAL (/odm/bin/hw/vendor.oplus.hardware.biometrics.fingerprint
# @2.1-service_uff) picks the AOSP sensor type it reports from these persistent
# properties, and it is the only binary on the device that reads/writes them.
# "side" makes it report FingerprintSensorProperties.TYPE_POWER_BUTTON (4),
# which is what makes SystemUI's SideFpsOverlayViewBinder draw the side
# fingerprint animation next to the power button instead of an under-display
# (UDFPS) one.  The stock OPLUS build ships the same layouts (sidefps_view.xml,
# sidefps_progress_bar.xml), so this is the path the OEM uses too.
#
# They normally live in /data/property/persistent_properties, which is gone
# after a factory reset, so seed the shipped values here.  The HAL overwrites
# them as needed.  persist.vendor.fingerprint.version ("UFF V1.0.0.0") cannot
# be expressed here because make splits on the space; the HAL sets it itself.
PRODUCT_SYSTEM_PROPERTIES += \
    persist.vendor.fingerprint.sensor_type=side \
    persist.vendor.fingerprint.fp_id=J_SIDE_0103 \
    persist.vendor.fingerprint.side.sensorlocation=64.960-78.990-155.7360::0-0-0 \
    persist.vendor.fingerprint.optical.support=1 \
    persist.vendor.fingerprint.side.broken.check=0 \
    persist.vendor.side.fp.near.feature.support=1

PRODUCT_SOONG_NAMESPACES += device/oneplus/OP68F7L1

# Inherit the vendor repository generated by extract-files.py
# (vendor/oneplus/OP68F7L1). It does not exist before the first extraction.
ifneq ($(wildcard vendor/oneplus/OP68F7L1/OP68F7L1-vendor.mk),)
$(call inherit-product, vendor/oneplus/OP68F7L1/OP68F7L1-vendor.mk)
endif
